# hostile plan: seed=0
# expect: flaky-open fuse nfs
#
# FOUND AT HEAD (3813c62) BY THIS EXERCISER, 2026-08-22. NOT FIXED --
# product code is outside the hostile-agent run's territory. Filed for
# triage under "hostile-agent" in docs/TODO.md.
#
# THE FINDING. A file created and then RENAMED inside one session can be
# left visible under BOTH names once a checkpoint seals between the two
# operations. The directory listing gains a ghost:
#
#     d/sub: entries differ
#         mount:     [c013.dat f00.txt f01.txt f02.txt m000.dat ...] (44 entries)
#         reference: [f00.txt f01.txt f02.txt m000.dat ...]          (43 entries)
#
# c013.dat is a rename SOURCE. It was created, renamed to m013.dat, and a
# --snapshot-interval checkpoint published in between; the new name is
# there, and so is the old one. The reference tree on tmpfs, given the
# identical op sequence, holds only the new name.
#
# NOT A FRONTEND BUG. It was first seen on the NFS backend and then
# reproduced on FUSE, which rules out go-nfs and internal/vfsbilly --
# raw FUSE resolves no paths at all. It is in the layer both share: the
# merge of the overlay against the generations a checkpoint keeps
# publishing underneath it.
#
# WHY IT MATTERS MORE THAN ONE STRAY NAME. At scale the ghosts accumulate
# and the listing degrades badly. In a 5,482-op run at a 100ms cadence
# one directory held 3,080 entries where the reference held 7, the same
# names repeated hundreds of times, and directories were also MISSING
# entries that were never touched. Downstream, `rm -rf` fails outright:
#
#     rmrf storm2.renamed/bigdir90
#       reference: ok
#       mount:     removeat storm2.renamed/bigdir90: directory not empty
#
# which is the same sentence as the release-week bug the owner reported
# (`rm: .../condor_tests: Directory not empty`) arrived at by a different
# route. A sweep removes everything the listing named; entries the
# listing never named survive, and the rmdir behind them refuses.
#
# THE AMPLIFIER, and why this entry is `flaky-open` rather than
# `known-open`. It is a RACE between a checkpoint sealing and the ops
# around it, so it fires only sometimes: roughly 2 runs in 3 for this
# plan at a 100ms cadence, and rarely at the 1s cadence CI uses. Raise
# the rate on demand:
#
#     scripts/hostile-docker.sh --plan \
#       internal/hostile/testdata/corpus/rename-ghost-across-checkpoint.plan \
#       --snapshot 100ms --run TestHostileFUSE
#
# 85 ops, about 6 seconds. Do NOT read a passing run as a fix.
#
# The product default is --snapshot-interval 5m, so a checkpoint lands
# between a create and a rename only in a long session -- which is
# exactly the session nobody runs in a gate, and exactly the one a user
# has.
mkdir d mode=0755
mkdir d/sub mode=0755
create d/sub/f00.txt len=32 fill=41
create d/sub/f01.txt len=32 fill=41
create d/sub/f02.txt len=32 fill=41
# Churn one directory across many checkpoints: create, rename, settle.
# The settle is what lets a checkpoint land BETWEEN the create and the
# rename, which is the whole mechanism.
create d/sub/c000.dat len=32 fill=42
rename d/sub/c000.dat -> d/sub/m000.dat
settle ms=150
create d/sub/c001.dat len=32 fill=42
rename d/sub/c001.dat -> d/sub/m001.dat
settle ms=150
create d/sub/c002.dat len=32 fill=42
rename d/sub/c002.dat -> d/sub/m002.dat
settle ms=150
create d/sub/c003.dat len=32 fill=42
rename d/sub/c003.dat -> d/sub/m003.dat
settle ms=150
create d/sub/c004.dat len=32 fill=42
rename d/sub/c004.dat -> d/sub/m004.dat
settle ms=150
create d/sub/c005.dat len=32 fill=42
rename d/sub/c005.dat -> d/sub/m005.dat
settle ms=150
create d/sub/c006.dat len=32 fill=42
rename d/sub/c006.dat -> d/sub/m006.dat
settle ms=150
create d/sub/c007.dat len=32 fill=42
rename d/sub/c007.dat -> d/sub/m007.dat
settle ms=150
create d/sub/c008.dat len=32 fill=42
rename d/sub/c008.dat -> d/sub/m008.dat
settle ms=150
create d/sub/c009.dat len=32 fill=42
rename d/sub/c009.dat -> d/sub/m009.dat
settle ms=150
create d/sub/c010.dat len=32 fill=42
rename d/sub/c010.dat -> d/sub/m010.dat
settle ms=150
create d/sub/c011.dat len=32 fill=42
rename d/sub/c011.dat -> d/sub/m011.dat
settle ms=150
create d/sub/c012.dat len=32 fill=42
rename d/sub/c012.dat -> d/sub/m012.dat
settle ms=150
create d/sub/c013.dat len=32 fill=42
rename d/sub/c013.dat -> d/sub/m013.dat
settle ms=150
create d/sub/c014.dat len=32 fill=42
rename d/sub/c014.dat -> d/sub/m014.dat
settle ms=150
create d/sub/c015.dat len=32 fill=42
rename d/sub/c015.dat -> d/sub/m015.dat
settle ms=150
create d/sub/c016.dat len=32 fill=42
rename d/sub/c016.dat -> d/sub/m016.dat
settle ms=150
create d/sub/c017.dat len=32 fill=42
rename d/sub/c017.dat -> d/sub/m017.dat
settle ms=150
create d/sub/c018.dat len=32 fill=42
rename d/sub/c018.dat -> d/sub/m018.dat
settle ms=150
create d/sub/c019.dat len=32 fill=42
rename d/sub/c019.dat -> d/sub/m019.dat
settle ms=150
compare
