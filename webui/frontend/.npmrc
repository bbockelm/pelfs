# The bundle in internal/webui/dist is committed and gated by a
# regenerate-and-diff job, so every input to the build is pinned: exact
# versions in package.json, a committed pnpm-lock.yaml, and
# --frozen-lockfile in both `go generate` and CI.
engine-strict=true
# pnpm 10 refuses lifecycle scripts by default; esbuild's is the one this
# build needs (it fetches nothing -- it links the platform binary already in
# the store). The allowlist lives in package.json's `pnpm.onlyBuiltDependencies`.
