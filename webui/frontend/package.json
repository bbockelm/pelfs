{
  "name": "pelfs-webui",
  "version": "0.0.0",
  "private": true,
  "description": "The pelfs browser UI. Built by `go generate ./internal/webui`; the output is committed, so `go build` never needs Node.",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.15.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "notices": "node tools/third-party.mjs",
    "licence-check": "node tools/licence-check.mjs",
    "offline-check": "node tools/offline-check.mjs",
    "test:e2e": "playwright test",
    "probe": "vite build --config probe/vite.probe.config.ts && node probe/run.mjs probe/probe.mjs",
    "probe:record": "vite build --config probe/vite.probe.config.ts && node probe/run.mjs probe/record.mjs"
  },
  "dependencies": {
    "@svar-ui/filemanager-data-provider": "2.6.0",
    "@svar-ui/react-filemanager": "2.6.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.0",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
